   "source": [
    "## 6. Language detection on a sample\n",
    "\n",
    "The challenge is from Rakuten France, so we expect French dominance with some English and possibly other European languages. We sample 1000 designations and guess the language with `langdetect`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "a867c501",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-05-01T12:24:26.181709Z",
     "iopub.status.busy": "2026-05-01T12:24:26.181398Z",
     "iopub.status.idle": "2026-05-01T12:24:30.711949Z",
     "shell.execute_reply": "2026-05-01T12:24:30.710027Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "lang\n",
      "fr    610\n",
      "en    219\n",
      "de     67\n",
      "ca     22\n",
      "nl     22\n",
      "ro     12\n",
      "it      9\n",
      "pt      8\n",
      "es      7\n",
      "no      6\n",
      "Name: count, dtype: int64\n",
      "sample size: 1000 | unique langs: 20\n"
     ]
    }
   ],
   "source": [
    "from langdetect import detect, DetectorFactory\n",
    "DetectorFactory.seed = 0\n",
    "\n",
    "samp = train[['designation']].dropna().sample(1000, random_state=42)\n",
    "def safe_detect(s):\n",
    "    try:\n",
